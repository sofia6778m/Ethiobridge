PORT=5000
MONGO_URI=mongodb://localhost:27017/ethiobridge

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CLIENT_URL=http://localhost:5173

# Admin bootstrap account (created automatically if missing, with the password below)
ADMIN_EMAIL=admin@ethiobridge.et
ADMIN_PASSWORD=change_me_after_first_login

# Secret key that unlocks the self-service admin reactivation endpoint
# (POST /api/auth/admin/reactivate). Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_REACTIVATION_KEY=generate_a_random_64_char_hex_value_here

# ── Notification delivery gateways ──────────────────────────────────────────────
# Email via Nodemailer (SMTP). Leave SMTP_HOST unset to log instead of sending.
SMTP_HOST=your_smtp_host.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=EthioBridge <no-reply@ethiobridge.et>

# SMS via a generic HTTP gateway. Disabled until SMS_ENABLED=true.
# POSTs JSON { phone, message, sender } to SMS_API_URL with an optional
# `Authorization: Bearer <SMS_API_KEY>` header.
SMS_ENABLED=false
SMS_API_URL=https://provider.example.com/sms/send
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=EthioBridge

# ── Online payment gateways (Chapa / Coopay-Amole) ─────────────────────────────
# Leave unset to fall back to the manual QR + bank-transfer donation flow.
# Chapa: https://chapa.co
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1
# Coopay Commerce (Amole / CBE Birr online checkout): https://commerce.coopay.co
COOPAY_API_KEY=
COOPAY_BASE_URL=https://commerce.coopay.co/checkout/init
